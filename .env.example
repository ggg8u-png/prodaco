# 프로다 환경변수 예시 — 실제 값은 Netlify 대시보드에서 설정합니다.
#   Netlify → Site configuration → Environment variables
#
# 이 파일은 "어떤 값이 있는지" 알려주는 문서입니다. 실제 값을 여기 적지 마세요.

# ─── 필수 아님(없어도 빌드·동작 정상) ────────────────────────────────────────
# GA4 측정 ID. 비어 있으면 GA 스크립트 자체가 렌더되지 않고, trackEvent 는 조용히 무시됩니다.
# analytics.google.com 에서 GA4 속성을 만들면 G- 로 시작하는 ID 가 발급됩니다.
NEXT_PUBLIC_GA_ID=

# 사이트 절대 URL. 미설정 시 https://prodaco.kr 로 폴백합니다.
NEXT_PUBLIC_SITE_URL=

# Google Drive 사진 원본(서버/빌드 스크립트 전용 — NEXT_PUBLIC_* 사용 금지)
# 현재 운영 폴더는 링크 공개 상태이므로 폴더 ID만으로 읽을 수 있습니다.
GOOGLE_DRIVE_WORKSITE_FOLDER_ID=
GOOGLE_DRIVE_BEFOREAFTER_FOLDER_ID=

# 향후 비공개 폴더 어댑터용 예약 변수입니다. 현재 공개 폴더 스캐너는
# 이 값을 사용하지 않습니다. 실제 인증정보는 절대 저장소에 커밋하지 마세요.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# 응대 안내 문구 오버라이드(선택). 미설정 시 content/settings.json 값을 씁니다.
NEXT_PUBLIC_RESPONSE_TIME_TEXT=

# 생성할 키워드 페이지 수 긴급 오버라이드(선택). 평소에는 설정하지 말고
# 어드민(/admin) ⑪ 색인·SEO 설정에서 관리하세요.
GENERATE_COUNT=

# AI 초안 생성(향후 서버 adapter 연결용). 기본값 none은 외부 API를 절대 호출하지 않습니다.
# 지원 예정 provider: openai | anthropic | gemini
# 모델 이름은 provider adapter를 실제 연결한 뒤에만 지정하세요. API 키는 이 파일에 적지 마세요.
AI_PROVIDER=none
AI_MODEL=
# AI 초안은 항상 운영자 검토 후 발행합니다. true를 넣어도 자동 발행은 지원하지 않습니다.
AI_AUTO_PUBLISH=false

# 서버측 AI 초안 예약 실행 — 현재는 반드시 false로 유지하세요.
# 활성화에는 별도 운영 승인, provider adapter, server queue storage가 모두 필요합니다.
AI_SCHEDULER_ENABLED=false
AI_SCHEDULER_MAX_ITEMS=5
AI_SCHEDULER_MAX_RETRIES=3
