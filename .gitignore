# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / local tooling
/.vscode/
/.idea/

# build-fetched gallery assets (regenerated by scripts/fetch-gallery.mjs on build)
/public/assets/

# internal SEO QA artifacts (not part of the deployed site)
/reports/
/tests/
/scripts/seo-*.mjs
/scripts/lib/
# 예외 — 색인 판정/리포트 생성기는 커밋 대상인 content/seo.json 의 extraIndexSlugs 를
# 만들어내므로 저장소에 있어야 재현·재실행이 가능하다(npm run seo:decide).
!/scripts/seo-index-decision.mjs
!/scripts/seo-index-report.mjs
