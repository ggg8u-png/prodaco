# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / local tooling
/.vscode/
/.idea/

# build-fetched gallery assets (regenerated by scripts/fetch-gallery.mjs on build)
/public/assets/

# 작업사진 파이프라인 산출물 — 원본/스테이징은 대용량·재생성 가능이라 커밋 제외.
# (manifest·인벤토리·운영자 결정 JSON 과 승인된 public/images/work WebP 는 커밋 대상 —
#  빌드가 네트워크 없이 결정적으로 재현되게 한다)
/content/photos/originals/
/content/photos/derived/

# 사이트맵 lastmod 맵 — 빌드 전에 git 커밋 날짜에서 생성(scripts/build-lastmod.mjs).
# 커밋하면 매 배포마다 diff 가 생기므로 산출물로 둔다. 없으면 SITE_LASTMOD 폴백.
/content/lastmod.json

# internal SEO QA artifacts (not part of the deployed site)
/reports/*
!/reports/stabilization-error-inventory.md
!/reports/stabilization-final-qa.md
/tests/
/scripts/seo-*.mjs
/scripts/lib/
# 예외 — 색인 판정/리포트 생성기는 커밋 대상인 content/seo.json 의 extraIndexSlugs 를
# 만들어내므로 저장소에 있어야 재현·재실행이 가능하다(npm run seo:decide).
!/scripts/seo-index-decision.mjs
!/scripts/seo-index-report.mjs
!/scripts/seo-page-audit.mjs
