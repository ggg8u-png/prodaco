{
  "name": "proda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fetch-gallery.mjs && node scripts/build-lastmod.mjs && npm run seo:gate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "fetch:photos": "node scripts/fetch-gallery.mjs",
    "photos:scan": "node scripts/photos-scan.mjs",
    "photos:sync": "node scripts/photos-sync.mjs",
    "photos:optimize": "node scripts/photos-optimize.mjs",
    "photos:audit": "node scripts/photos-audit.mjs",
    "photos:review": "node scripts/photos-review.mjs",
    "photos:all": "npm run photos:scan && npm run photos:sync && npm run photos:optimize && npm run photos:audit",
    "promote": "node scripts/promote-keywords.mjs",
    "seo:lastmod": "node scripts/build-lastmod.mjs",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "seo:audit": "node scripts/audit-seo.mjs",
    "seo:gate": "npm run test:seo && npm run test:photos && npm run seo:quality && npm run seo:validate-index && npm run seo:verify",
    "test:seo": "node scripts/ts-run.mjs scripts/seo-tests.ts && node scripts/ts-run.mjs scripts/phase09-content-verify.ts && node scripts/ts-run.mjs scripts/phase10-sitemap-audit.ts",
    "test:photos": "node scripts/ts-run.mjs scripts/workphotos-verify.ts && node scripts/ts-run.mjs scripts/drive-projects-verify.ts",
    "seo:quality": "node scripts/ts-run.mjs scripts/seo-quality-audit.ts",
    "seo:quality:full": "node scripts/ts-run.mjs scripts/seo-quality-audit.ts --full",
    "seo:pseo-quality": "node scripts/ts-run.mjs scripts/phase11-pseo-quality.ts",
    "seo:links": "node scripts/ts-run.mjs scripts/phase12-link-architecture.ts",
    "seo:hosts": "node scripts/phase13-host-audit.mjs",
    "seo:brand": "node scripts/ts-run.mjs scripts/phase14-brand-audit.ts",
    "ai:verify": "node scripts/ts-run.mjs scripts/phase17-ai-verify.ts",
    "ai:queue:verify": "node scripts/ts-run.mjs scripts/phase18-ai-queue-verify.ts",
    "ai:scheduler:verify": "node scripts/ts-run.mjs scripts/phase19-scheduler-verify.ts",
    "seo:search-data": "node scripts/ts-run.mjs scripts/phase20-search-data.ts",
    "seo:urls": "node scripts/ts-run.mjs scripts/seo-url-audit.ts",
    "seo:validate-index": "node scripts/ts-run.mjs scripts/seo-validate-index.ts",
    "seo:pages": "node scripts/seo-page-audit.mjs",
    "test:routes": "node scripts/stabilization-route-smoke.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "seo:serp": "node scripts/ts-run.mjs scripts/gsc-serp-analyze.ts",
    "seo:decide": "node scripts/seo-index-decision.mjs",
    "seo:decide:write": "node scripts/seo-index-decision.mjs --write",
    "typecheck": "tsc --noEmit",
    "verify:dns": "node scripts/check-dns-txt.mjs",
    "seo:verify": "node scripts/ts-run.mjs scripts/verify-seo.ts"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "next": "15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.26",
    "sharp": "0.35.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
